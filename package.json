{
  "name": "a-la-cancha",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm run start -w @alacancha/mobile",
    "web": "npm run web -w @alacancha/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import ./scripts/test-aliases.mjs --test packages/domain/test/*.test.mjs apps/mobile/src/lib/*.test.mjs",
    "export:web": "npm run export:web -w @alacancha/mobile",
    "export:native": "npm run export:native -w @alacancha/mobile",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "~6.0.3"
  }
}
